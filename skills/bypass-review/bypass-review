# ---------------------------------------------------------------------------
# Runtime roots — hooks/_lib/_paths when it can be loaded, else its rule
# ---------------------------------------------------------------------------

_PATHS_UNLOADED = object()
_PATHS_MODULE: object = _PATHS_UNLOADED


def _load_praxis_paths():
    """`hooks/_lib/_paths` from the checkout this CLI lives in, or None.

    `__file__` is a ~/.local/bin symlink; `os.path.realpath` follows it to
    `skills/bypass-review/bypass-review`, whose `parents[2]` is the repo root
    (the same anchor `default_manifest_path` uses). `_paths` imports its
    sibling `_state_lock` by bare name, so `_lib` is on `sys.path` for the
    duration of the import and off again after. The module is loaded under a
    private name rather than `import _paths`, so a `_paths` a test harness
    already holds in `sys.modules` is neither reused nor displaced. Every
    failure returns None: the callers fall back to the inline rule, so the CLI
    never fails to start over a resolver it could not load.
    """
    try:
        lib = Path(os.path.realpath(__file__)).parents[2] / "hooks" / "_lib"
        src = lib / "_paths.py"
        if not src.is_file():
            return None
        import importlib.util
        spec = importlib.util.spec_from_file_location("_bypass_review_paths", str(src))
        if spec is None or spec.loader is None:
            return None
        mod = importlib.util.module_from_spec(spec)
        sys.path.insert(0, str(lib))
        try:
            spec.loader.exec_module(mod)
        finally:
            try:
                sys.path.remove(str(lib))
            except ValueError:
                pass
        return mod
    except Exception:
        return None


def _praxis_paths():
    """Memoised `_load_praxis_paths()` — one import attempt per process."""
    global _PATHS_MODULE
    if _PATHS_MODULE is _PATHS_UNLOADED:
        _PATHS_MODULE = _load_praxis_paths()
    return _PATHS_MODULE


def default_praxis_home() -> Path:
    """`PRAXIS_HOME` (tilde-expanded), else `~/.praxis` (issue #1340).

    `_paths.praxis_home()` when the resolver loads; otherwise the same
    one-line rule restated, so an import failure changes nothing a user can
    observe. With PRAXIS_HOME unset both branches give `Path.home()/.praxis`.
    """
    paths = _praxis_paths()
    if paths is not None:
        try:
            return Path(paths.praxis_home())
        except Exception:
            pass
    return Path(os.path.expanduser(os.environ.get("PRAXIS_HOME") or "~/.praxis"))


def default_telemetry_dir() -> Path:
    """Where the writers put the ledgers when nothing overrides them.

    `<praxis home>/telemetry` — `_fire_ledger.resolve_telemetry_dir()` minus
    its development-checkout branch, which is a writer-side diversion for a
    hook running out of a checkout and not where a reader looks by default
    (`--dir <checkout>/.praxis-dev-telemetry` reads such a ledger).
    """
    return default_praxis_home() / "telemetry"


def default_legacy_strike_state_dir() -> Path:
    """The pre-#527 `~/.claude/state/praxis/strikes` — `_paths.legacy_state_dir()`
    when the resolver loads, else the literal it returns."""
    paths = _praxis_paths()
    if paths is not None:
        try:
            return Path(paths.legacy_state_dir()) / "strikes"
        except Exception:
            pass
    return Path(os.path.expanduser("~/.claude/state/praxis/strikes"))


