# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Planning files (user-specific)
task_plan.md
notes.md
research_notes.md

# Logs & temp
*.log
tmp/

# Python
__pycache__/
*.pyc
# mypy's incremental cache — scripts/run-tests.sh step 13 writes it at
# the repo root; a local run artifact, never a source of truth.
.mypy_cache/

# OMC (oh-my-claudecode local state)
.omc/
.omx/

# Agent worktrees created by `isolation: worktree` subagents. These are
# embedded git checkouts under .claude/worktrees/agent-*/ that `git add -A`
# would otherwise stage as embedded repos and drag into commits/pushes.
# Ignore the worktrees dir narrowly so other tracked .claude/ config is unaffected.
.claude/worktrees/

# Runtime wrappers under hooks/<name>.sh are generated by
# scripts/build-plugin-manifests.py but ARE committed: marketplace
# plugin installs do not run the build script, so the wrappers must
# be present in the checkout for ${CLAUDE_PLUGIN_ROOT}/hooks/<name>.sh
# to resolve. See ADR-0001 §2.3 + Codex round-1 P1 finding.

# Dev-checkout fire ledger (issue #934): hooks run out of a git checkout
# write telemetry here instead of ~/.praxis/telemetry, so running a single
# test file cannot pollute the real ledger.
.praxis-dev-telemetry/

# coverage.py data file — a local run artifact, never a source of truth.
# It was committed once by accident (PR #1025); this keeps it out.
.coverage
.coverage.*
htmlcov/
