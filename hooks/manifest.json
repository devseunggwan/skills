      ],
      "requires": [
        "codex-plugin"
      ],
      "timeout": 5,
      "review_by": "2026-12-04",
      "mode": {
        "external_commands": [
          "git worktree list --porcelain",
          "git rev-parse --abbrev-ref HEAD",
          "gh pr view <branch> --json state --jq .state"
